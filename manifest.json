{
  "name": "Amigo — Academic Organizer",
  "short_name": "Amigo",
  "description": "AI-powered academic organizer for university students",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#0f2240",
  "theme_color": "#1a3a6b",
  "orientation": "portrait",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "video/*",
            "audio/*",
            "text/*",
            "application/*",
            ".pdf",
            ".doc",
            ".docx",
            ".ppt",
            ".pptx",
            ".xls",
            ".xlsx",
            ".csv",
            ".zip",
            ".rar",
            ".txt"
          ]
        }
      ]
    }
  }
}